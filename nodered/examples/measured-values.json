[
  {
    "id": "m2m-example-tab",
    "type": "tab",
    "label": "matter2mqtt",
    "disabled": false,
    "info": "Reads a temperature/humidity sensor by name and lists the fabric."
  },
  {
    "id": "m2m-example-broker",
    "type": "matter2mqtt-broker",
    "name": "matter2mqtt",
    "brokerUrl": "mqtt://127.0.0.1:1883",
    "prefix": "matter",
    "clientIdPrefix": "node-red-matter2mqtt"
  },
  {
    "id": "m2m-example-in",
    "type": "matter2mqtt in",
    "z": "m2m-example-tab",
    "name": "TEMP Ikea",
    "broker": "m2m-example-broker",
    "device": "TEMP Ikea",
    "mode": "measured",
    "custom": "",
    "endpoint": "",
    "scale": true,
    "precision": "",
    "onNull": "drop",
    "x": 180,
    "y": 120,
    "wires": [["m2m-example-switch"]]
  },
  {
    "id": "m2m-example-switch",
    "type": "switch",
    "z": "m2m-example-tab",
    "name": "split by cluster",
    "property": "matter.cluster",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "1026", "vt": "num" },
      { "t": "eq", "v": "1029", "vt": "num" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 420,
    "y": 120,
    "wires": [["m2m-example-temp"], ["m2m-example-hum"]]
  },
  {
    "id": "m2m-example-temp",
    "type": "debug",
    "z": "m2m-example-tab",
    "name": "temperature °C",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 660,
    "y": 80,
    "wires": []
  },
  {
    "id": "m2m-example-hum",
    "type": "debug",
    "z": "m2m-example-tab",
    "name": "humidity %",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 650,
    "y": 160,
    "wires": []
  },
  {
    "id": "m2m-example-inject",
    "type": "inject",
    "z": "m2m-example-tab",
    "name": "toggle the light",
    "props": [{ "p": "payload" }],
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 340,
    "wires": [["m2m-example-out"]]
  },
  {
    "id": "m2m-example-out",
    "type": "matter2mqtt out",
    "z": "m2m-example-tab",
    "name": "Salotto / Toggle",
    "broker": "m2m-example-broker",
    "mode": "command",
    "device": "Salotto",
    "endpoint": "1",
    "cluster": "OnOff",
    "attribute": "",
    "command": "Toggle",
    "scale": true,
    "timeout": 60,
    "x": 430,
    "y": 340,
    "wires": [[]]
  },
  {
    "id": "m2m-example-fabric",
    "type": "matter2mqtt device",
    "z": "m2m-example-tab",
    "name": "discovered fabric",
    "broker": "m2m-example-broker",
    "device": "",
    "emitOnChange": true,
    "x": 190,
    "y": 240,
    "wires": [["m2m-example-fabric-debug"]]
  },
  {
    "id": "m2m-example-fabric-debug",
    "type": "debug",
    "z": "m2m-example-tab",
    "name": "devices",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 460,
    "y": 240,
    "wires": []
  }
]
